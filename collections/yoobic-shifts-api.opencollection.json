          },
          "http": {
            "method": "GET",
            "url": "https://<base_url>/public/api/shifts/count?where=:where",
            "headers": [
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "where",
                "value": "{ \"property\": \"value\" }",
                "type": "query",
