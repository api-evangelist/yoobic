{
  "opencollection": "1.0.0",
  "info": {
    "name": "YOOBIC Public Answers Chats API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Chats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://<base_url>/public/api/chats",
            "headers": [
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/",
              "accessTokenUrl": "/",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Send a chat message from a user to another user."
        }
      ]
    }
  ],
  "bundled": true
}